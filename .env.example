# Copy to .env for local development. Never commit .env or API keys.
ENV=local
LOG_LEVEL=INFO
AWS_REGION=eu-west-1

# Mesh API (https://app.meshapi.ai -> API Keys)
MESH_API_KEY=replace_with_your_mesh_api_key
MESH_BASE_URL=https://api.meshapi.ai/v1
GENERATION_MODEL_ID=openai/gpt-oss-20b
REWRITE_MODEL_ID=openai/gpt-oss-20b
MAX_OUTPUT_TOKENS=900
TEMPERATURE=0.1

# PostgreSQL / pgvector vector database. The Mesh embedding model returns 1536 dimensions by default.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
POSTGRES_DB=primark_sop
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_SSLMODE=disable
POSTGRES_TABLE=sop_chunks
# Optional connection URL override:
# POSTGRES_URL=postgresql://postgres:postgres@localhost:5432/primark_sop?sslmode=disable

EMBEDDING_MODEL_NAME=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
RETRIEVAL_TOP_K=6
RETRIEVAL_CANDIDATES=30
MAX_CHUNKS_PER_SOP=3

# Optional AWS Bedrock Guardrails. Leave GUARDRAIL_ID blank to use app-level safety checks only.
GUARDRAIL_ID=
GUARDRAIL_VERSION=DRAFT
GUARDRAIL_FAIL_OPEN=false

# Local development only. Production requires JWT authentication and a DynamoDB session table.
AUTH_DISABLED=true
JWT_ISSUER=
JWT_AUDIENCE=
JWKS_URL=
SESSIONS_TABLE=
SESSION_TTL_SECONDS=86400
HISTORY_TURNS=4
SOP_BUCKET=
CORS_ORIGINS=
